{
  "name": "@hawkeyexl/dockg",
  "version": "0.1.0",
  "description": "Deterministic knowledge graphs derived from documentation frontmatter and formatting, saved as Turtle.",
  "type": "module",
  "bin": {
    "dockg": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ns",
    "schemas",
    "shapes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkeyexl/dockg.git"
  },
  "homepage": "https://github.com/hawkeyexl/dockg#readme",
  "bugs": {
    "url": "https://github.com/hawkeyexl/dockg/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.6.3"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup",
    "dev": "node scripts/clean-dist.mjs && tsup --watch",
    "test": "vitest run",
    "test:real": "vitest run --config vitest.real.config.ts",
    "test:real:fill": "vitest run --config vitest.fill.config.ts",
    "test:real:cross": "node test/real/cross-platform.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:check-strategy": "node scripts/check-content-strategy.mjs",
    "docs:check-links": "node scripts/check-docs-links.mjs",
    "docs:check-cli": "node scripts/check-cli-reference.mjs",
    "docs:check-doc-tests": "node scripts/check-doc-tests.mjs",
    "docs:test": "doc-detective --exit-on-fail && node scripts/check-doc-tests.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "semantic-release": "semantic-release",
    "prepare": "husky",
    "prepublishOnly": "node scripts/check-publishable.mjs && npm run build"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,yaml,yml}": [
      "prettier --check",
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "keywords": [
    "knowledge-graph",
    "rdf",
    "turtle",
    "skos",
    "frontmatter",
    "markdown",
    "documentation",
    "cli"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huggingface/transformers": ">=4"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "@hawkeyexl/inference": "^0.3.1",
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "docmeta": "^4.12.0",
    "fast-glob": "^3.3.2",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "n3": "^1.26.0",
    "parse5": "^8.0.1",
    "picocolors": "^1.1.1",
    "rdf-validate-shacl": "^0.6.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@comunica/query-sparql-rdfjs-lite": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@rdfjs/types": "^2.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jsonld": "^1.5.15",
    "@types/mdast": "^4.0.4",
    "@types/n3": "^1.26.0",
    "@types/node": "^26.0.1",
    "@types/yauzl": "^3.4.0",
    "doc-detective": "^4.38.1",
    "esbuild": "^0.27.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsonld": "^9.0.0",
    "lint-staged": "^17.1.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "rdfxml-streaming-parser": "^3.3.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9",
    "yauzl": "^3.4.0"
  }
}
