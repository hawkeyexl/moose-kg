# package.json declares "engines", but npm treats that as advisory by default
# and installs anyway. Make it binding so a too-old Node or npm fails at install
# time rather than somewhere deep in a build.
#
# The npm floor is load-bearing, not hygiene: npm <= 11.6.2 writes a lockfile
# that drops the top-level entries for optional platform packages, which is what
# `npm ci` then rejects (ADR 01023). The floor cannot ride on the Node floor,
# because they are not in step — Node 24.11.0 satisfies ">=24" and bundles npm
# 11.6.1, below the floor. Without this, that contributor regenerates a broken
# lockfile and CI goes red with nothing pointing at why.
engine-strict=true
